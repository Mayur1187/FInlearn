# ─────────────────────────────────────────────────────────────
# FinLiteracy — Environment Variables
# Copy this file to .env and fill in your keys.
# Never commit .env to version control!
# ─────────────────────────────────────────────────────────────

# Flask secret key (change to a long random string in production)
SECRET_KEY=your-super-secret-key-here

# ── FEATURE 1: Google OAuth ────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client
# 3. Application type: Web
# 4. Authorised redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── FEATURE 1: GitHub OAuth ────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Homepage URL: http://localhost:5000
# 3. Authorization callback URL: http://localhost:5000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── FEATURE 2: AI Mentor (LLaMA 3) ────────────────────────────────────────────
# Option A – Groq API (recommended: free tier, fast)
#   Sign up at https://console.groq.com/ → API Keys
GROQ_API_KEY=your-groq-api-key

# Option B – Ollama (run LLaMA 3 locally)
#   1. Install: https://ollama.ai
#   2. Run: ollama pull llama3 && ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# Option C – Anthropic Claude (existing fallback)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
